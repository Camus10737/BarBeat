rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isVenueOwner(venueId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/venues/$(venueId)).data.ownerUserId == request.auth.uid;
    }

    // Admins : chaque user peut lire son propre document (pour vérifier son rôle)
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    // Venues : lecture publique, écriture admin ou owner
    match /venues/{venueId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || isVenueOwner(venueId);
      allow delete: if isAdmin();
    }

    // Sessions : lecture publique, écriture DJ authentifié ou admin
    match /sessions/{sessionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // QueueItems : lecture publique, ajout public (avec validation), update/delete DJ authentifié
    match /queueItems/{itemId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll([
        'venueId', 'sessionId', 'itunesTrackId', 'title', 'artist',
        'coverUrl', 'duration', 'requestedBy', 'requestCount',
        'status', 'requestedAt'
      ]) && request.resource.data.status == 'pending';
      // Autoriser les likes publics (seulement likedBy + likeCount modifiables)
      allow update: if request.auth != null ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount']);
      allow delete: if request.auth != null;
    }
  }
}
